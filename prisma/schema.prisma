generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String              @id @default(cuid())
  email                   String              @unique
  name                    String
  role                    Role
  createdAt               DateTime            @default(now())
  authId                  String?             @unique
  customRequestsAsArtisan CustomRequest[]     @relation("ArtisanRequests")
  customRequestsAsBuyer   CustomRequest[]     @relation("BuyerRequests")
  orders                  Order[]
  products                Product[]
  rentals                 Rental[]
  rooms                   Room[]
  roomScans               RoomScan[]
  traceabilityChains      TraceabilityChain[]
}

model Product {
  id           String             @id @default(cuid())
  name         String
  description  String
  images       String[]
  materialType String
  artisanId    String
  createdAt    DateTime           @default(now())
  listings     Listing[]
  artisan      User               @relation(fields: [artisanId], references: [id])
  traceability TraceabilityChain?
}

model Listing {
  id        String        @id @default(cuid())
  productId String
  type      ListingType
  price     Float
  createdAt DateTime      @default(now())
  status    ListingStatus @default(DRAFT)
  views     Int           @default(0)
  product   Product       @relation(fields: [productId], references: [id])
  orders    Order[]
  rentals   Rental[]
}

model JunkShop {
  id            String              @id @default(cuid())
  name          String
  city          String
  materials     String[]
  verifiedAt    DateTime?
  address       String?
  image         String?
  galleryImages String[]
  materialsList Material[]
  traceChains   TraceabilityChain[]
}

model TraceabilityChain {
  id                String   @id @default(cuid())
  productId         String   @unique
  wasteSupplierName String
  junkShopId        String
  artisanId         String
  artisan           User     @relation(fields: [artisanId], references: [id])
  junkShop          JunkShop @relation(fields: [junkShopId], references: [id])
  product           Product  @relation(fields: [productId], references: [id])
}

model Order {
  id        String      @id @default(cuid())
  buyerId   String
  listingId String
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  buyer     User        @relation(fields: [buyerId], references: [id])
  listing   Listing     @relation(fields: [listingId], references: [id])
}

model Rental {
  id           String       @id @default(cuid())
  buyerId      String
  listingId    String
  startDate    DateTime
  endDate      DateTime
  returnedAt   DateTime?
  refurbStatus RefurbStatus @default(IN_USE)
  buyer        User         @relation(fields: [buyerId], references: [id])
  listing      Listing      @relation(fields: [listingId], references: [id])
}

model DemandSignal {
  id        String   @id @default(cuid())
  keyword   String
  city      String
  count     Int      @default(1)
  createdAt DateTime @default(now())
}

model Material {
  id         String   @id @default(cuid())
  junkShopId String
  type       String
  quantityKg Float
  pricePerKg Float
  available  Boolean  @default(true)
  junkShop   JunkShop @relation(fields: [junkShopId], references: [id])
}

model RoomScan {
  id              String   @id @default(cuid())
  buyerId         String
  imageUrl        String
  recommendations String[]
  createdAt       DateTime @default(now())
  analysis        Json?
  roomId          String   @unique
  buyer           User     @relation(fields: [buyerId], references: [id])
  Room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([buyerId])
}

model CustomRequest {
  id          String        @id @default(cuid())
  buyerId     String
  artisanId   String
  description String
  budget      Float?
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  artisan     User          @relation("ArtisanRequests", fields: [artisanId], references: [id])
  buyer       User          @relation("BuyerRequests", fields: [buyerId], references: [id])
}

model Room {
  id                 String                 @id @default(cuid())
  userId             String
  imageUrl           String
  generationStatus   Room3DGenerationStatus @default(PENDING)
  roomTheme          String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  sceneData          Json?
  generationProvider String?
  externalJobId      String?                @unique
  worldAssetUrl      String?
  worldAssetFormat   String?
  previewImageUrl    String?
  providerStatus     String?
  providerError      String?
  providerPayload    Json?
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  RoomScan           RoomScan?

  @@index([userId])
}

enum Role {
  BUYER
  ARTISAN
  SUPPLIER
}

enum Room3DGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ListingType {
  SALE
  RENT
  LEASE
}

enum ListingStatus {
  DRAFT
  AVAILABLE
  IN_USE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

enum RefurbStatus {
  IN_USE
  AWAITING
  REFURBISHING
}

model MaterialRequest {
  id           String        @id @default(cuid())
  materialType String
  quantityKg   Float
  dateNeeded   DateTime
  description  String?
  photoUrl     String?
  status       RequestStatus @default(PENDING)
  createdAt    DateTime      @default(now())
}
