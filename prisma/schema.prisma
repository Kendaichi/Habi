generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  ARTISAN
  SUPPLIER
}

enum Room3DGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ListingType {
  SALE
  RENT
  LEASE
}

enum ListingStatus {
  DRAFT
  AVAILABLE
  IN_USE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

enum RefurbStatus {
  IN_USE
  AWAITING
  REFURBISHING
}

model User {
  id                      String              @id @default(cuid())
  authId                  String?             @unique
  email                   String              @unique
  name                    String
  role                    Role
  createdAt               DateTime            @default(now())
  products                Product[]
  orders                  Order[]
  rentals                 Rental[]
  roomScans               RoomScan[]
  customRequestsAsBuyer   CustomRequest[]     @relation("BuyerRequests")
  customRequestsAsArtisan CustomRequest[]     @relation("ArtisanRequests")
  rooms                   Room[]
  traceabilityChains      TraceabilityChain[]
}

model Product {
  id           String             @id @default(cuid())
  name         String
  description  String
  images       String[]
  materialType String
  artisanId    String
  artisan      User               @relation(fields: [artisanId], references: [id])
  createdAt    DateTime           @default(now())
  listings     Listing[]
  traceability TraceabilityChain?
}

model Listing {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  type      ListingType
  price     Float
  status    ListingStatus @default(DRAFT)
  views     Int           @default(0)
  createdAt DateTime      @default(now())
  orders    Order[]
  rentals   Rental[]
}

model JunkShop {
  id            String              @id @default(cuid())
  name          String
  city          String
  address       String?
  materials     String[]
  verifiedAt    DateTime?
  traceChains   TraceabilityChain[]
  materialsList Material[]
}

model TraceabilityChain {
  id                String   @id @default(cuid())
  productId         String   @unique
  product           Product  @relation(fields: [productId], references: [id])
  wasteSupplierName String
  junkShopId        String
  junkShop          JunkShop @relation(fields: [junkShopId], references: [id])
  artisanId         String
  artisan           User     @relation(fields: [artisanId], references: [id])
}

model Order {
  id        String      @id @default(cuid())
  buyerId   String
  buyer     User        @relation(fields: [buyerId], references: [id])
  listingId String
  listing   Listing     @relation(fields: [listingId], references: [id])
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
}

model Rental {
  id           String       @id @default(cuid())
  buyerId      String
  buyer        User         @relation(fields: [buyerId], references: [id])
  listingId    String
  listing      Listing      @relation(fields: [listingId], references: [id])
  startDate    DateTime
  endDate      DateTime
  returnedAt   DateTime?
  refurbStatus RefurbStatus @default(IN_USE)
}

model DemandSignal {
  id        String   @id @default(cuid())
  keyword   String
  city      String
  count     Int      @default(1)
  createdAt DateTime @default(now())
}

model Material {
  id         String   @id @default(cuid())
  junkShopId String
  junkShop   JunkShop @relation(fields: [junkShopId], references: [id])
  type       String
  quantityKg Float
  pricePerKg Float
  available  Boolean  @default(true)
}

model RoomScan {
  id              String   @id @default(cuid())
  buyerId         String
  buyer           User     @relation(fields: [buyerId], references: [id])
  imageUrl        String
  recommendations String[]
  createdAt       DateTime @default(now())
}

model CustomRequest {
  id          String        @id @default(cuid())
  buyerId     String
  buyer       User          @relation("BuyerRequests", fields: [buyerId], references: [id])
  artisanId   String
  artisan     User          @relation("ArtisanRequests", fields: [artisanId], references: [id])
  description String
  budget      Float?
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
}

model Room {
  id               String                 @id @default(cuid())
  userId           String
  imageUrl         String
  generationStatus Room3DGenerationStatus @default(PENDING)
  roomTheme        String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
