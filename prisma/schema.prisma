generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  ARTISAN
  SUPPLIER
}

enum ListingType {
  SALE
  RENT
  LEASE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

model User {
  id                     String          @id @default(cuid())
  email                  String          @unique
  name                   String
  role                   Role
  createdAt              DateTime        @default(now())
  products               Product[]
  orders                 Order[]
  rentals                Rental[]
  roomScans              RoomScan[]
  customRequestsAsBuyer  CustomRequest[] @relation("BuyerRequests")
  customRequestsAsArtisan CustomRequest[] @relation("ArtisanRequests")
}

model Product {
  id           String             @id @default(cuid())
  name         String
  description  String
  images       String[]
  materialType String
  artisanId    String
  artisan      User               @relation(fields: [artisanId], references: [id])
  createdAt    DateTime           @default(now())
  listings     Listing[]
  traceability TraceabilityChain?
}

model Listing {
  id        String      @id @default(cuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id])
  type      ListingType
  price     Float
  available Boolean     @default(true)
  createdAt DateTime    @default(now())
  orders    Order[]
  rentals   Rental[]
}

model JunkShop {
  id            String              @id @default(cuid())
  name          String
  city          String
  materials     String[]
  verifiedAt    DateTime?
  traceChains   TraceabilityChain[]
  materialsList Material[]
}

model TraceabilityChain {
  id                String   @id @default(cuid())
  productId         String   @unique
  product           Product  @relation(fields: [productId], references: [id])
  wasteSupplierName String
  junkShopId        String
  junkShop          JunkShop @relation(fields: [junkShopId], references: [id])
  artisanId         String
}

model Order {
  id        String      @id @default(cuid())
  buyerId   String
  buyer     User        @relation(fields: [buyerId], references: [id])
  listingId String
  listing   Listing     @relation(fields: [listingId], references: [id])
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
}

model Rental {
  id         String    @id @default(cuid())
  buyerId    String
  buyer      User      @relation(fields: [buyerId], references: [id])
  listingId  String
  listing    Listing   @relation(fields: [listingId], references: [id])
  startDate  DateTime
  endDate    DateTime
  returnedAt DateTime?
}

model DemandSignal {
  id        String   @id @default(cuid())
  keyword   String
  city      String
  count     Int      @default(1)
  createdAt DateTime @default(now())
}

model Material {
  id         String   @id @default(cuid())
  junkShopId String
  junkShop   JunkShop @relation(fields: [junkShopId], references: [id])
  type       String
  quantityKg Float
  pricePerKg Float
  available  Boolean  @default(true)
}

model RoomScan {
  id              String   @id @default(cuid())
  buyerId         String
  buyer           User     @relation(fields: [buyerId], references: [id])
  imageUrl        String
  recommendations String[]
  createdAt       DateTime @default(now())
}

model CustomRequest {
  id          String        @id @default(cuid())
  buyerId     String
  buyer       User          @relation("BuyerRequests", fields: [buyerId], references: [id])
  artisanId   String
  artisan     User          @relation("ArtisanRequests", fields: [artisanId], references: [id])
  description String
  budget      Float?
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
}
